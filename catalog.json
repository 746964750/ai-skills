  "groups": [
    {
      "id": "requirements",
      "title": "需求与产品",
      "description": "从原始材料或产品想法建立可追溯、可评审的需求。",
      "guidance": "文档抽取选 requirement-extractor；WCS 范围选专项抽取；需求探索选 requirements-analysis；PRD 撰写与评审按产物选择。"
    },
    {
      "id": "design",
      "title": "设计与界面",
      "description": "完成原型、设计稿还原、界面质量改进和行业样式落地。",
      "guidance": "通用原型选 prd-to-prototype；设计还原选 design-to-code；WMS 项目按终端选择 PDA 或管理端样式。"
    },
    {
      "id": "engineering",
      "title": "架构与工程规范",
      "description": "认识现有架构、识别技术债并维护工程约束。",
      "guidance": "仓库摸底选 code-analyzer；架构设计选 system-architect；工程文档与检查机制选 harness-maintainer。"
    },
    {
      "id": "development",
      "title": "开发与重构",
      "description": "实现功能，或在既有行为约束下改进代码结构。",
      "guidance": "功能实现选 ai-coder；完整重构选 code-refactoring；小范围精简选 simplify；原则性指导选 uncle-bob。"
    },
    {
      "id": "quality",
      "title": "审查与测试",
      "description": "核对需求与实现，设计测试并建立质量反馈。",
      "guidance": "改动审查选 code-review；用例交付选 test-case-generator；按单测、接口、E2E 或 TDD 目标选择测试技能。"
    },
    {
      "id": "debugging",
      "title": "故障诊断",
      "description": "通过症状、日志与复现证据定位故障并验证修复。",
      "guidance": "一般故障先选 diagnosing-bugs；日志分析选 log-analyzer；其余调试流程按任务选一个，避免重复串联。"
    },
    {
      "id": "utilities",
      "title": "工作与系统工具",
      "description": "整理工作记录和分析本机存储。",
      "guidance": "报工选 hs-warranty-report；磁盘占用选 storage-analyzer，先区分只读报告和执行清理。"
    }
  ],
